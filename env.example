# .env.example — Copia para Railway → Variables
# NUNCA commitar o ficheiro .env real

# ── LLM ──────────────────────────────────────────
# FASE 1 (gratuito)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=AIza_COLOCA_AQUI

# FASE 2 (mudar só estas linhas para Claude)
# LLM_PROVIDER=claude
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-COLOCA_AQUI

# ── IBKR ─────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT=1
IBKR_TRADING_MODE=paper    # mudar para "live" quando pronto

# ── NOTIFICAÇÕES (opcional) ───────────────────────
EMAIL_FROM=o_teu_email@gmail.com
EMAIL_TO=o_teu_email@gmail.com
EMAIL_PASSWORD=app_password_gmail

PUSHOVER_APP=token_da_app_pushover
PUSHOVER_USER=chave_do_utilizador_pushover

# ── AMBIENTE ──────────────────────────────────────
RAILWAY_ENV=development
LOG_LEVEL=INFO
PORT=5000
# ── FLUXO INSTITUCIONAL (opcional) ────────────────
UNUSUAL_WHALES_TOKEN=token_unusual_whales_aqui
FLOW_SCAN_INTERVAL=60
FLOW_MIN_CONFIDENCE=60
